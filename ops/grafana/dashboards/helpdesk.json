    {
      "type": "stat",
      "title": "/ask error rate (5xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(helpdesk_http_requests_total{route=\"/ask\",status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(helpdesk_http_requests_total{route=\"/ask\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2013",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
