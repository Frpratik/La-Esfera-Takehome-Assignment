# --- API ---
API_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- LLM: mock (offline, default) | openai (Groq/Ollama/OpenAI-compatible) ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Mock returns "I don't know" below this top score (hash embedder scores are lower, so it has its own)
MOCK_SCORE_THRESHOLD=0.35
MOCK_SCORE_THRESHOLD_HASH=0.10
# Estimated price per 1K tokens (mock is always 0)
PRICE_PER_1K_PROMPT=0.0
PRICE_PER_1K_COMPLETION=0.0

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# true = deterministic hashing embedder (offline fallback)
USE_HASH_EMBEDDER=false

# --- Index / retrieval ---
POLICIES_DIR=data/policies
INDEX_DIR=data/index
CHUNK_SIZE=120
CHUNK_OVERLAP=30
TOP_K=4
# dense | hybrid (embeddings + BM25 rank fusion)
RETRIEVAL_MODE=hybrid
# Rebuild the index at startup when policy documents changed since it was built
AUTO_REBUILD_INDEX=true

# --- Database (SQLite for local dev/tests; Postgres in docker-compose) ---
DATABASE_URL=sqlite:///./helpdesk.db

# --- Docker Compose only ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_DB=helpdesk
# URL the BROWSER uses to reach the API (baked into the frontend bundle at build time)
PUBLIC_API_URL=http://localhost:8000
